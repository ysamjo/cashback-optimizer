{
  "manifest_version": 3,
  "name": "Cashback-Optimizer Suite",
  "version": "1.4.6",
  "description": "Zeigt Cashback-Möglichkeiten auf unterstützten Shopseiten und ergänzt Links im Cashback-Optimizer.",
  "permissions": ["storage", "activeTab", "tabs", "contextMenus"],
  "host_permissions": [
    "https://cashback-optimizer.de/*",
    "https://*.cashback-optimizer.de/*"
  ],
  "action": {
    "default_title": "Cashback-Optimizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://cashback-optimizer.de/*",
        "https://*.cashback-optimizer.de/*",
        "https://kolateeprojects.gitlab.io/cashback_optimizer*"
      ],
      "js": ["optimizer-preload.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cashback-optimizer.de/*",
        "https://*.cashback-optimizer.de/*",
        "https://kolateeprojects.gitlab.io/cashback_optimizer*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
