<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFBE7"
        android:orientation="vertical"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Search Bar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="#F5EFCB">

            <ImageButton
                android:id="@+id/btn_search_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/close" />

            <EditText
                android:id="@+id/edit_search_query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:textColor="#282200"
                android:textColorHint="#948554"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/btn_search_clear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                android:contentDescription="@string/clear" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DFCE93" />

        <!-- Search Results List -->
        <ListView
            android:id="@+id/list_search_results"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:divider="#EFE7BF"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/text_search_empty"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="@string/search_no_results"
            android:textColor="#8C7A43"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
